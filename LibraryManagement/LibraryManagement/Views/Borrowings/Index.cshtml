@model IEnumerable<LibraryManagement.Application.DTOs.BorrowingDto>
@{ViewData["Title"]="Borrowings";}
<h1>Borrowings</h1><p><a asp-action="Create" class="btn btn-primary">Create New</a></p><table class="table table-striped"><thead><tr><th>CustomerName</th><th>BookTitle</th><th>BorrowDate</th><th>ReturnDate</th><th>Actions</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.CustomerName</td><td>@item.BookTitle</td><td>@item.BorrowDate</td><td>@item.ReturnDate</td><td><a asp-action="Edit" asp-route-uuid="@item.Uuid" class="btn btn-warning">Edit</a> <a asp-action="Details" asp-route-uuid="@item.Uuid" class="btn btn-info">Details</a> <a asp-action="Delete" asp-route-uuid="@item.Uuid" class="btn btn-danger">Delete</a></td></tr>}</tbody></table>
