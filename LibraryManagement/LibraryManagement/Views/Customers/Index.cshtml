@model IEnumerable<LibraryManagement.Application.DTOs.CustomerDto>
@{ViewData["Title"]="Customers";}
<h1>Customers</h1><p><a asp-action="Create" class="btn btn-primary">Create New</a></p><table class="table table-striped"><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Actions</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Name</td><td>@item.Email</td><td>@item.Phone</td><td><a asp-action="Edit" asp-route-uuid="@item.Uuid" class="btn btn-warning">Edit</a> <a asp-action="Details" asp-route-uuid="@item.Uuid" class="btn btn-info">Details</a> <a asp-action="Delete" asp-route-uuid="@item.Uuid" class="btn btn-danger">Delete</a></td></tr>}</tbody></table>
