@model LibraryManagement.Application.DTOs.CustomerDto
<h1>Delete Customer</h1><div asp-validation-summary="All" class="text-danger"></div><p>Are you sure you want to delete this item?</p><dl class="row"><dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd><dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd><dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd></dl><form asp-action="Delete" asp-route-uuid="@Model.Uuid" method="post"><button type="submit" class="btn btn-danger">Delete</button> <a asp-action="Index">Back to List</a></form>
