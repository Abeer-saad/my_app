@model LibraryManagement.Application.DTOs.BookDto
<h1>Delete Book</h1><div asp-validation-summary="All" class="text-danger"></div><p>Are you sure you want to delete this item?</p><dl class="row"><dt class="col-sm-3">Title</dt><dd class="col-sm-9">@Model.Title</dd><dt class="col-sm-3">Author</dt><dd class="col-sm-9">@Model.Author</dd><dt class="col-sm-3">Price</dt><dd class="col-sm-9">@Model.Price</dd><dt class="col-sm-3">CategoryName</dt><dd class="col-sm-9">@Model.CategoryName</dd></dl><form asp-action="Delete" asp-route-uuid="@Model.Uuid" method="post"><button type="submit" class="btn btn-danger">Delete</button> <a asp-action="Index">Back to List</a></form>
