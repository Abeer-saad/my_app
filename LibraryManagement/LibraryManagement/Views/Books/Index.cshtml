@model IEnumerable<LibraryManagement.Application.DTOs.BookDto>
@{ViewData["Title"]="Books";}
<h1>Books</h1><p><a asp-action="Create" class="btn btn-primary">Create New</a></p><table class="table table-striped"><thead><tr><th>Title</th><th>Author</th><th>Price</th><th>CategoryName</th><th>Actions</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Title</td><td>@item.Author</td><td>@item.Price</td><td>@item.CategoryName</td><td><a asp-action="Edit" asp-route-uuid="@item.Uuid" class="btn btn-warning">Edit</a> <a asp-action="Details" asp-route-uuid="@item.Uuid" class="btn btn-info">Details</a> <a asp-action="Delete" asp-route-uuid="@item.Uuid" class="btn btn-danger">Delete</a></td></tr>}</tbody></table>
